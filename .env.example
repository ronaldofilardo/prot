# Copie para .env.local e preencha com valores reais. Nunca commitar
# .env/.env.local com credenciais reais (ver histórico anterior deste
# projeto, que tinha senha fraca e NEXTAUTH_SECRET fixos versionados).

DATABASE_URL="postgresql://usuario:senha@host:5432/prot_db?schema=public"

# gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Integração Protheus (botão "Atualizar do Protheus") ---
# "rest" (padrao, recomendado) ou "soap" (fallback para Protheus sem REST habilitado)
PROTHEUS_INTEGRATION_MODE="rest"

# Codigo da empresa/filial no Protheus (nao confundir com o empresaId do SaaS)
PROTHEUS_EMPRESA_ID="01"
PROTHEUS_FILIAL="01"

# --- Modo REST ---
PROTHEUS_REST_BASE_URL="https://host:porta"
# "basic" ou "bearer"
PROTHEUS_REST_AUTH_MODE="bearer"
PROTHEUS_REST_USER=""
PROTHEUS_REST_PASSWORD=""
# Cole somente o valor de access_token (sem aspas extras e sem "Bearer ").
# O token expira; substitua-o quando o Protheus emitir um novo.
PROTHEUS_REST_ACCESS_TOKEN=""
# Guarde aqui o refresh_token recebido. A renovacao automatica ainda depende
# da confirmacao do metodo/payload exigido pelo endpoint /rest/index/TOKEN.
PROTHEUS_REST_REFRESH_TOKEN=""

# --- Modo SOAP (fallback) ---
PROTHEUS_SOAP_ENDPOINT="https://host:porta/wsdl/service.apw"
PROTHEUS_SOAP_USER=""
PROTHEUS_SOAP_PASSWORD=""

# --- API key do endpoint /api/ingest (batch externo) ---
# gerar com: openssl rand -hex 32
INGEST_API_KEY=""

# --- Chave de criptografia das credenciais Protheus no banco ---
# Usada por src/lib/security/crypto-vault.ts (AES-256-GCM).
# gerar com: openssl rand -base64 32
PROTHEUS_CRED_ENCRYPTION_KEY=""

